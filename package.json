{
  "name": "kmucs-alumni",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "description": "KMU-CS Alumni - 국민대학교 소프트웨어융합대학 졸업 동문회 웹사이트",
  "scripts": {
    "dev": "pnpm --filter @kmucs/signage-player build && astro dev",
    "build": "pnpm --filter @kmucs/signage-player build && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:signage": "pnpm --filter @kmucs/signage-player test && node --test apps/signage-desktop/test/*.test.mjs src/lib/newsletter-summaries.test.mjs src/lib/newsletter-edition.test.mjs",
    "check:signage": "pnpm --filter @kmucs/signage-player build && pnpm --filter @kmucs/signage-player check && pnpm --filter @kmucs/signage-desktop check && pnpm check:web",
    "signage:dev": "pnpm --filter @kmucs/signage-player build && pnpm --filter @kmucs/signage-desktop dev",
    "signage:demo": "pnpm --filter @kmucs/signage-player build && pnpm --filter @kmucs/signage-desktop demo",
    "signage:build": "pnpm --filter @kmucs/signage-player build && pnpm --filter @kmucs/signage-desktop build",
    "signage:dist": "pnpm signage:build && pnpm --filter @kmucs/signage-desktop dist:win",
    "check:web": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/react": "^5.0.1",
    "@astrojs/sitemap": "^3.7.1",
    "@kmucs/signage-player": "workspace:*",
    "@vanilla-extract/css": "^1.20.0",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "@vanilla-extract/vite-plugin": "^4.0.20",
    "astro": "^6.0.8",
    "html-to-image": "^1.11.13",
    "parse5": "^7.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
