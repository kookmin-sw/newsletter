---
import { ClientRouter } from 'astro:transitions';
import { lightTheme } from '@/styles/theme.css';
import { layout, main } from '@/components/templates/MainLayout';
import { Header } from '@/components/organisms/Header';
import { Footer } from '@/components/organisms/Footer';
import { url, asset } from '@/lib/path';
import siteConfig from '@/content/config/site.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  currentPath?: string;
}

const {
  title,
  description = siteConfig.description,
  ogImage = siteConfig.ogImage,
  currentPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${siteConfig.title}`
  : siteConfig.title;

const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : new URL(asset(ogImage), siteConfig.siteUrl).toString();
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
---

<!doctype html>
<html lang="ko" class={lightTheme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={siteConfig.title} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  {ogImage === siteConfig.ogImage && <>
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>}
  <meta property="og:image:alt" content={pageTitle} />
  <meta property="og:locale" content="ko_KR" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={pageTitle} />

  <title>{pageTitle}</title>

  <!-- JSON-LD 구조화 데이터 -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": siteConfig.title,
    "url": new URL(url('/'), siteConfig.siteUrl).toString(),
    "logo": new URL(asset('/images/logo.svg'), siteConfig.siteUrl).toString(),
    "description": siteConfig.description,
    "contactPoint": {
      "@type": "ContactPoint",
      "email": siteConfig.organization.email,
      "contactType": "general"
    }
  })} />

  <!-- Pretendard 웹폰트 -->
  <link
    rel="stylesheet"
    as="style"
    crossorigin
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
  />

  <link rel="icon" type="image/svg+xml" href={asset('/images/logo.svg')} />
  <link rel="sitemap" href={asset('/sitemap-index.xml')} />
  <ClientRouter />
  <style is:global>
    .skip-link {
      position: fixed;
      top: 0.75rem;
      left: 1rem;
      z-index: 1000;
      padding: 0.75rem 1rem;
      background: #fff;
      color: #1A5BC4;
      border-radius: 0.75rem;
      transform: translateY(-200%);
    }
    .skip-link:focus { transform: translateY(0); }
    html {
      overflow-y: scroll;
    }
    #app-layout {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }
    #app-layout > main {
      flex: 1;
    }
    .page-section {
      padding-block: 4rem;
    }
    @media (max-width: 768px) {
      .page-section { padding-block: 2.5rem; }
    }
    .page-container {
      width: 100%;
      max-width: 1200px;
      margin-inline: auto;
      padding-inline: 1rem;
    }
    @media (min-width: 768px) {
      .page-container { padding-inline: 1.5rem; }
    }
    @media (min-width: 1024px) {
      .page-container { padding-inline: 2rem; }
    }
    .narrow-container {
      width: 100%;
      max-width: 850px;
      margin-inline: auto;
      padding-inline: 1rem;
    }
    @media (min-width: 768px) {
      .narrow-container { padding-inline: 1.5rem; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">본문 바로가기</a>
  <div id="app-layout" class={layout}>
    <Header
      client:load
      navigation={siteConfig.navigation.map((n: any) => ({ ...n, href: url(n.href) }))}
      currentPath={currentPath}
    />
    <main id="main-content" class={main} tabindex="-1">
      <slot />
    </main>
    <Footer
      client:load
      externalLinks={siteConfig.externalLinks}
    />
  </div>
  <script>
    // View Transitions: swap 전에 현재 페이지의 CSS를 새 문서에 복사
    document.addEventListener('astro:before-swap', (e) => {
      // <link rel="stylesheet"> 보존
      const links = document.head.querySelectorAll('link[rel="stylesheet"]');
      links.forEach((link) => {
        const href = link.getAttribute('href');
        if (href && !e.newDocument.head.querySelector(`link[href="${href}"]`)) {
          e.newDocument.head.appendChild(link.cloneNode(true));
        }
      });
      // 동적 <style> 태그 보존 (vanilla-extract dev 모드)
      const styles = document.head.querySelectorAll('style');
      styles.forEach((s) => {
        if (!s.textContent?.includes('@font-face') && !s.textContent?.includes('astro-island')) {
          e.newDocument.head.appendChild(s.cloneNode(true));
        }
      });
    });

  </script>
</body>
</html>
