---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DisplayTool } from '@/components/organisms/DisplayTool';
import { getCollection } from 'astro:content';
import QRCode from 'qrcode';

// 푸터용 사이트 QR (링크에서 생성)
const footerQr = await QRCode.toDataURL('https://alumni.cs.kookmin.ac.kr', {
  margin: 1,
  width: 240,
  color: { dark: '#000000', light: '#ffffff' },
});

// 뉴스 기사 import용 목록
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((a) => ({
    id: a.id,
    title: a.data.title,
    excerpt: a.data.excerpt ?? a.data.subtitle ?? '',
    author: a.data.author ?? '',
    tags: a.data.tags ?? [],
  }));
---

<BaseLayout title="디스플레이 생성기" currentPath="/tools/display">
  <section class="page-section">
    <div class="page-container">
      <p><a href="/signage/setup/">2대·3대·4대 디스플레이 편성 →</a></p>
      <p><a href="/signage/">전체 화면 사이니지 미리보기 →</a></p>
      <DisplayTool client:load footerQr={footerQr} articles={articles} />
    </div>
  </section>
</BaseLayout>
