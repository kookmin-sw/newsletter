---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { NewsletterBuilder } from '@/components/organisms/NewsletterBuilder';
import { getCollection } from 'astro:content';

// 섹션을 기존 기사와 빠르게 연결할 수 있도록 목록 전달
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .map((a) => ({
    id: a.id,
    title: a.data.title,
    excerpt: a.data.excerpt ?? '',
    image: a.data.coverImage ?? a.data.thumbnail ?? '',
    tags: a.data.tags ?? [],
    author: a.data.author ?? '',
  }));

// 실제 1호 뉴스레터(최종본) 전체 콘텐츠를 시드로 주입
const initialSections = [
  {
    category: '보도자료',
    author: '윤민우 기자',
    title: `국민대학교, 'KMU-CS EXPO'로 확장된 캡스톤디자인 전시 프로젝트·기업·진로를 잇는 소프트웨어 교류의 장`,
    desc: `국민대학교 소프트웨어융합대학이 기존 캡스톤디자인 전시를 확장한 'KMU-CS EXPO'를 통해 학생 프로젝트와 산업 현장을 연결하는 복합 행사로 발전시켰다. 이번 행사에는 약 200여 명의 학생이 참여해 40여 개 팀으로 나뉘어 웹 서비스, 인공지능, 모바일 애플리케이션, 게임 등 다양한 분야의 프로젝트를 선보였으며, 단순 전시를 넘어 시연과 발표를 통해 개발 과정과 기술적 특징을 공유했다.

행사장은 시연 부스와 포스터 발표, 기업 부스가 함께 구성되어 관람과 교류가 동시에 이루어졌고, 일부 우수 팀은 별도의 발표 세션을 통해 프로젝트를 심층적으로 소개했다. 또한 잡페어와 기업 설명회, 기술 강연이 병행되며 학생들은 산업 현장의 요구 역량과 진로 방향을 구체적으로 이해할 수 있는 기회를 얻었다. 특히 카카오엔터프라이즈와 LG CNS 등 기업 관계자들의 참여로 실무 경험과 현장 사례가 공유됐으며, 글로벌 커리어 워크숍을 통해 해외 취업과 다양한 진로 가능성도 제시됐다. 이번 EXPO는 교육과 연구 성과를 함께 공개하며 실무 중심 교육의 결과를 보여주는 자리로 의미를 더했다.`,
    href: '/articles/2025-kmu-cs-expo',
    image: '/images/articles/expo-main.png',
    tags: ['캡스톤', 'EXPO'],
  },
  {
    category: '보도자료',
    author: '류진 기자',
    title: `국민대학교, 고등학생 대상 알고리즘 대회로 미래 소프트웨어 인재 발굴 이어와`,
    desc: `국민대학교 소프트웨어융합대학이 매년 개최하는 '국민대학교 알고리즘 대회'는 고등학생을 대상으로 한 대표적인 소프트웨어 경진대회로, 창의적인 문제 해결 능력과 프로그래밍 역량을 갖춘 미래 인재를 발굴하는 장으로 자리 잡았다. 10회를 맞이한 이 대회는 누구나 참여할 수 있는 개방형 프로그램으로 운영되며, 단순한 경쟁을 넘어 학생들이 자신의 역량을 시험하고 성장할 수 있는 기회를 제공한다. 특히 알고리즘 역량이 산업 전반에서 핵심 능력으로 강조되는 가운데, 참가자들은 실질적인 문제 해결 경험을 통해 소프트웨어 분야의 잠재력을 키워가고 있다.

최근 인공지능 기술 발전으로 코드 생성이 자동화되는 흐름 속에서, 이번 대회는 코드 검증과 설명, 책임 있는 활용 능력의 중요성을 반영해 구성되었다. 대상은 김유담 학생이 수상했으며, 장려상 이상 수상자에게는 소프트웨어 특기자전형 지원 기회가 제공된다. 또한 대회는 SW중심대학사업단과 ㈜그렙의 협력으로 운영되며, 산업과 연계된 교육 환경을 보여준다. 국민대학교는 이러한 프로그램을 통해 지속적으로 소프트웨어 인재 발굴·양성하며, 2026년 제11회 대회를 이어갈 계획이다.`,
    href: '/articles/2025-algorithm-contest',
    image: '/images/articles/algorithm-contest-.jpg',
    tags: ['알고리즘', '인재발굴'],
  },
  {
    category: '보도자료',
    author: '문가은 기자',
    title: `국민대 소프트웨어융합대학, 자율주행 SW 인재 양성의 메카로 우뚝`,
    desc: `국민대학교 소프트웨어융합대학이 주최한 '2025 자율주행 경진대회'가 성공적으로 개최되며 실무형 소프트웨어 인재 양성 성과를 입증했다. 이번 대회는 학생들이 직접 설계한 자율주행 알고리즘을 실제 모형차에 적용해 문제 해결 능력을 검증하는 실전형 교육의 장으로 운영됐다. 참가자들은 파이썬 기반 프로그래밍을 바탕으로 영상처리와 센서 데이터 분석 기술을 활용해 신호등 인식, 장애물 회피, 정밀 추월 등 고난도 미션을 수행하며 이론과 실무를 결합한 역량을 보여주었다.

전국 18개 대학에서 선발된 24개 팀이 본선에 진출해 경쟁을 펼쳤으며, 국민대학교 자율주행 스튜디오를 중심으로 대학 간 기술 교류와 협력이 이루어졌다. 이 가운데 국민대학교에서는 오토코봇 등 총 4개 팀이 본선에 진출해 프로젝트를 선보였으며, 모든 참가 팀은 아이디어를 실제 차량 제어 알고리즘으로 구현하며 높은 완성도를 입증했다. 이번 대회는 팀 프로젝트 기반 협업과 산업 환경을 반영한 문제 해결 경험을 제공하며, 기업이 요구하는 실전형 인재 양성 모델을 제시했다. 국민대학교는 이를 바탕으로 산학 협력 중심 교육을 지속 확대해 나갈 계획이다.`,
    href: '/articles/2025-autonomous-driving-contest',
    image: '/images/articles/KakaoTalk_20250828_154928457_03.jpg',
    tags: ['경진대회', '산학협력'],
  },
  {
    category: '보도자료',
    author: '김보민 기자',
    title: `2025 KMUCS 커리어위크 성료… "산학연계를 통한 미래 SW 인재 양성의 장 열려"`,
    desc: `국민대학교 소프트웨어융합대학이 개최한 '2025 커리어위크(Career Week)'가 5일간 진행되며 산학 협력과 인재 매칭의 장으로 자리매김했다. 학생, 교수, 동문, 기업이 함께 참여한 이번 행사는 단순한 진로 탐색을 넘어 실질적인 교류와 협력을 중심으로 운영됐다. 행사 초반에는 스마일게이트, 몰로코, 데이터브릭스 등 현업 동문과 Apple, Meta 등 글로벌 기업 전문가들이 참여한 강연과 워크숍이 진행되어 데이터 스토리텔링과 커리어 경험을 공유했다. 또한 해외 연수 프로그램 성과 발표를 통해 학생들의 글로벌 역량도 확인됐다.

중반에는 AI·SW+X Day와 잡페어, 1:1 인터뷰 및 멘토링이 이어지며 기업과 학생 간 실질적인 채용 연계 기회가 마련됐다. 학생들은 융합 프로젝트 발표를 통해 협업과 문제 해결 능력을 보여주었으며, 후반부에는 신입생 중심의 프로젝트 전시와 커리어 특강이 진행되어 저학년부터 진로 설계를 지원하는 교육 체계를 드러냈다. 마지막으로 학생, 교수, 동문이 함께하는 교류 프로그램으로 행사가 마무리되며, 국민대학교는 실무 중심 인재 양성과 산학 협력 강화 지속해 나갈 계획이다.`,
    href: '/articles/2025-career-week',
    image: '/images/articles/career-week-main.jpg',
    tags: ['취업', '멘토링'],
  },
  {
    category: '홍보자료',
    author: '김보민 기자',
    title: `국민대 소프트웨어융합대학, 2026 KMUCS EXPO 및 모각공 개최... 미래 SW 인재 양성의 장 열린다`,
    desc: `국민대학교 소프트웨어융합대학이 2026년 상반기를 맞아 학생들의 진로 탐색과 학업 성장을 지원하는 '모각공'과 '2026 KMUCS EXPO'를 운영한다. 오는 5월 26일부터 29일까지 열리는 KMUCS EXPO는 글로벌 커리어 워크숍, 잡페어, AWS-Day, 캡스톤디자인 전시 등으로 구성되어 학생들에게 진로 탐색과 실무 경험 기회를 제공한다. 특히 해외 전문가 초청 강연과 기업 참여 프로그램을 통해 산업 현장과의 연결을 강화했으며, 다양한 이벤트도 함께 마련해 참여도를 높일 예정이다.

한편 4월 6일부터 시작되는 모각공은 기존 '모각코'를 확장한 자기주도 학습 프로그램으로, 올해부터 모든 재학생이 참여할 수 있도록 신청 조건을 완화했다. 참가자들은 팀 단위로 자율적인 스터디와 프로젝트를 수행하며, 간식 지원과 우수팀 포상, 강의실 대여 등 다양한 혜택을 받는다. 두 프로그램은 학생들이 협업과 문제 해결 능력을 기르며 실무형 인재로 성장할 수 있도록 지원하는 핵심 교육 모델로 기대를 모은다.`,
    href: '/articles/2026-mogakgong-expo',
    image: '/images/articles/mogakgong-main.png',
    tags: ['행사일정', '학생지원'],
  },
];
---

<BaseLayout title="뉴스레터 만들기">
  <section class="page-section">
    <div class="page-container">
      <NewsletterBuilder client:load articles={articles} initialSections={initialSections} />
    </div>
  </section>
</BaseLayout>
